# ==============================================================================
# BIDAR CONNECT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# COPY THIS FILE TO .env IN PRODUCTION / LOCAL DEV AND FILL IN REAL VALUES.
# NEVER COMMIT THE ACTUAL .env FILE OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME="Bidar Connect"
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api/v1

# Security & CORS
SECRET_KEY=change-me-to-a-secure-random-64-character-key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# PostgreSQL Database (SQLAlchemy 2.x + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bidar_connect
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (Caching, Rate Limiting, OTP Throttling)
REDIS_URL=redis://localhost:6379/0

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Cloudinary (Storage for profiles, vehicle images, KYC docs)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Payment Gateway (To be finalized in Phase 10)
PAYMENT_GATEWAY_ENV=test
PAYMENT_GATEWAY_KEY_ID=your-key-id
PAYMENT_GATEWAY_KEY_SECRET=your-key-secret
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Third-Party External Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
FCM_SERVER_KEY=your-fcm-server-key
SENTRY_DSN=

# Business & Operational Defaults
DEFAULT_CURRENCY=INR
MIN_PAYOUT_DELAY_SECONDS=300

