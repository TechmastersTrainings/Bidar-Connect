{
  "name": "Bidar Connect Design Tokens",
  "version": "1.0.0",
  "colors": {
    "brand": {
      "navy": "#0F172A",
      "blue": {
        "primary": "#1E40AF",
        "interactive": "#2563EB",
        "hover": "#1D4ED8",
        "subtle": "#EFF6FF"
      }
    },
    "surface": {
      "canvas": "#F8FAFC",
      "card": "#FFFFFF",
      "muted": "#F1F5F9"
    },
    "border": {
      "subtle": "#E2E8F0",
      "focus": "#3B82F6",
      "strong": "#CBD5E1"
    },
    "text": {
      "heading": "#0F172A",
      "body": "#334155",
      "muted": "#64748B",
      "inverse": "#FFFFFF"
    },
    "status": {
      "success": {
        "text": "#15803D",
        "bg": "#F0FDF4",
        "border": "#BBF7D0"
      },
      "warning": {
        "text": "#B45309",
        "bg": "#FFFBEB",
        "border": "#FDE68A"
      },
      "error": {
        "text": "#B91C1C",
        "bg": "#FEF2F2",
        "border": "#FECACA"
      },
      "info": {
        "text": "#0369A1",
        "bg": "#F0F9FF",
        "border": "#BAE6FD"
      }
    }
  },
  "radii": {
    "none": "0px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "pill": "FORBIDDEN"
  },
  "typography": {
    "fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "scale": {
      "display": { "size": "36px", "lineHeight": "44px", "weight": "700" },
      "h1": { "size": "28px", "lineHeight": "36px", "weight": "600" },
      "h2": { "size": "20px", "lineHeight": "28px", "weight": "600" },
      "subheading": { "size": "16px", "lineHeight": "24px", "weight": "500" },
      "body": { "size": "15px", "lineHeight": "22px", "weight": "400" },
      "label": { "size": "14px", "lineHeight": "20px", "weight": "500" },
      "microcopy": { "size": "12px", "lineHeight": "16px", "weight": "400" }
    }
  }
}

